# DataGuard – Environment Variable Template
# Copy this file to ".env" and fill in your actual credentials.
# The ".env" file is git-ignored and must NEVER be committed to version control.
#
# These variables OVERRIDE values stored in the SQLite database when set.
# If not set, DataGuard falls back to the values configured in the
# "📧 Email Alerts & Notifications" admin settings panel.

# ── SMTP Transport ──────────────────────────────────────────────────────────
DATAGUARD_SMTP_HOST=smtp.gmail.com
DATAGUARD_SMTP_PORT=587

# ── Sender Identity ─────────────────────────────────────────────────────────
DATAGUARD_SENDER_EMAIL=your-email@gmail.com
DATAGUARD_SMTP_USER=your-email@gmail.com

# ── Authentication (use a Gmail App Password, not your account password) ────
# Generate at: https://myaccount.google.com/apppasswords
DATAGUARD_SMTP_PASSWORD=your-16-character-app-password-here

# ── Notes ───────────────────────────────────────────────────────────────────
# For Gmail: Enable 2FA → Generate an App Password → Paste it above.
# For Outlook/Office 365: SMTP host = smtp.office365.com, port = 587, TLS = true.
# For SendGrid: SMTP host = smtp.sendgrid.net, port = 587, user = "apikey",
#               password = your SendGrid API key.
# For local/mock testing: Leave all variables unset — DataGuard defaults to
#               sandbox (mock) mode and simulates delivery without real SMTP.
