# DataGuard – Environment Variable Template
# Copy this file to ".env" in the project root and fill in your actual credentials.
# The ".env" file is git-ignored and must NEVER be committed to version control.
#
# These variables OVERRIDE values stored in the SQLite database when set.
# If not set, DataGuard falls back to the values configured in the
# "📧 Email Alerts & Notifications" admin settings panel in the dashboard.

# ── 1. SMTP Transport (Gmail Standard) ──────────────────────────────────────
DATAGUARD_SMTP_HOST=smtp.gmail.com
DATAGUARD_SMTP_PORT=587

# ── 2. Sender Identity & Credentials ────────────────────────────────────────
DATAGUARD_SENDER_EMAIL=yourname@gmail.com
DATAGUARD_SMTP_USER=yourname@gmail.com

# ── 3. Google App Password (16 characters, spaces optional) ──────────────────
# IMPORTANT: Your normal Gmail account password WILL NOT WORK (rejected with 535 BadCredentials).
# Steps to generate:
# 1. Open Google Account Security: https://myaccount.google.com/security
# 2. Turn ON 2-Step Verification if not already enabled.
# 3. Open App Passwords: https://myaccount.google.com/apppasswords
# 4. Create an App named "DataGuard" and copy the 16-character code (e.g. abcd efgh ijkl mnop).
# 5. Paste that 16-character code below:
DATAGUARD_SMTP_PASSWORD=abcdefghijklmnop

# ── 4. Sandbox Mode Toggle ──────────────────────────────────────────────────
# Set to false to enable REAL SMTP email delivery to inboxes.
# Set to true for SIMULATED DELIVERY (Sandbox Mode).
DATAGUARD_SMTP_MOCK=false
